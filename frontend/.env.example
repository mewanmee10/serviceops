# Server-only API URL. Use the backend launch profile port.
BACKEND_API_URL=http://localhost:5093

# Optional restricted Google Maps browser key and JavaScript map ID; never commit real values.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional approved HTTPS production origin for public canonical, OG image and sitemap.
# Leave unset for local-only use. Never put credentials here.
SERVICEOPS_PUBLIC_ORIGIN=
